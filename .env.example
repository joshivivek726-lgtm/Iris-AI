# App
DEBUG=True
HOST=127.0.0.1
PORT=8000

# LLM (Ollama)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Google Custom Search JSON API (requires an API key and Programmable Search Engine ID)
GOOGLE_API_KEY= 
GOOGLE_CSE_ID= 
<div class="gcse-search"></div>

# Database
DATABASE_PATH=./iris.db
ENABLE_MEMORY=True
MAX_CONVERSATION_HISTORY=10

# Other
LOG_LEVEL=INFO
LOG_FILE=./logs/iris.log
API_TIMEOUT=600
